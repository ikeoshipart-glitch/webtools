---
import '../styles/global.css';
import '../styles/tools-extra.css';
import '../styles/catalog.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WebTools',
  url: Astro.site,
  description: 'Web制作で繰り返し使う小さな作業を、ブラウザ内で完結できる無料ツール集。',
  inLanguage: 'ja',
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="ChxBItZ8wJLGirYfTZekqkrSHAP_QJ440MrNzSMp6ow" />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="WebTools" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">本文へ移動</a>
    <div class="utility-bar">登録不要・すべて無料・入力内容は原則ブラウザ内で処理</div>
    <header class="site-header">
      <a class="logo" href="/" aria-label="WebTools トップページ"><span>WT</span> WebTools</a>
      <nav aria-label="メインナビゲーション">
        <a href="/#tools">ツール一覧</a><a href="/articles/">読みもの</a><a href="/about/">このサイトについて</a>
      </nav>
    </header>
    <div class="site-shell">
      <aside class="catalog-sidebar" aria-label="ツールカテゴリ">
        <div class="sidebar-inner">
          <h2 class="sidebar-title">カテゴリから探す</h2>
          <nav class="category-nav">
            <a class={pathname === '/' ? 'active' : undefined} href="/#tools"><span>すべてのツール</span><small>8</small></a>
            <a class={pathname.startsWith('/seo') ? 'active' : undefined} href="/seo/"><span>SEO・サイト設定</span><small>3</small></a>
            <a class={pathname.startsWith('/writing') ? 'active' : undefined} href="/writing/"><span>文章</span><small>1</small></a>
            <a class={pathname.startsWith('/developer') ? 'active' : undefined} href="/developer/"><span>開発・変換</span><small>3</small></a>
            <a class={pathname.startsWith('/security') ? 'active' : undefined} href="/security/"><span>セキュリティ</span><small>1</small></a>
            <a class={pathname.startsWith('/articles') ? 'active' : undefined} href="/articles/"><span>使い方・解説</span><small>2</small></a>
          </nav>
          <p class="sidebar-note">ツールは動作確認後に追加します。現在8種類を公開中です。</p>
        </div>
      </aside>
      <main id="content"><slot /></main>
    </div>
    <footer>
      <div><a class="logo footer-logo" href="/"><span>WT</span> WebTools</a><p>Web制作の小さな手間を、ブラウザだけで。</p></div>
      <nav aria-label="フッターナビゲーション"><a href="/about/">運営方針</a><a href="/updates/">更新履歴</a><a href="/privacy/">プライバシー</a><a href="/terms/">利用規約</a></nav>
      <p class="site-disclaimer">各ツールの結果は必ず内容を確認し、利用者自身の判断と責任でご利用ください。詳しくは<a href="/terms/">免責事項</a>をご確認ください。</p>
      <p class="copyright">© {new Date().getFullYear()} WebTools</p>
    </footer>
  </body>
</html>
