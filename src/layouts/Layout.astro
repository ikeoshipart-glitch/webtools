---
import '../styles/global.css';
import '../styles/tools-extra.css';
import '../styles/catalog.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WebTools',
  url: Astro.site,
  description: 'Web制作で繰り返し使う小さな作業を、ブラウザ内で完結できる無料ツール集。',
  inLanguage: 'ja',
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="ChxBItZ8wJLGirYfTZekqkrSHAP_QJ440MrNzSMp6ow" />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="WebTools" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">本文へ移動</a>
    <div class="utility-bar">登録不要・すべて無料・入力内容は原則ブラウザ内で処理</div>
    <header class="site-header">
      <a class="logo" href="/" aria-label="WebTools トップページ"><span>WT</span> WebTools</a>
      <nav aria-label="メインナビゲーション">
        <a href="/#tools">ツール一覧</a><a href="/articles/">読みもの</a><a href="/about/">このサイトについて</a>
      </nav>
    </header>
    <div class="site-shell">
      <aside class="catalog-sidebar" aria-label="サイト内メニュー">
        <details class="sidebar-inner" open>
          <summary class="sidebar-title">サイトメニュー</summary>
          <nav class="sidebar-menu" aria-label="サイト内ナビゲーション">
            <section class="sidebar-section">
              <p class="sidebar-label">ツールを探す</p>
              <a class:list={['sidebar-overview', {active: pathname === '/'}]} href="/#tools"><span>すべてのツール</span><small>8</small></a>
            </section>
            <section class="sidebar-section">
              <a class:list={['sidebar-category', {active: pathname === '/seo/'}]} href="/seo/"><strong>SEO・サイト設定</strong><small>3</small></a>
              <ul><li><a class:active={pathname === '/tools/sitemap-generator/'} href="/tools/sitemap-generator/">XMLサイトマップ生成</a></li><li><a class:active={pathname === '/tools/robots-txt-generator/'} href="/tools/robots-txt-generator/">robots.txt生成</a></li><li><a class:active={pathname === '/tools/meta-tag-generator/'} href="/tools/meta-tag-generator/">metaタグ生成</a></li></ul>
            </section>
            <section class="sidebar-section">
              <a class:list={['sidebar-category', {active: pathname === '/writing/'}]} href="/writing/"><strong>文章</strong><small>1</small></a>
              <ul><li><a class:active={pathname === '/tools/character-counter/'} href="/tools/character-counter/">文字数カウント</a></li></ul>
            </section>
            <section class="sidebar-section">
              <a class:list={['sidebar-category', {active: pathname === '/developer/'}]} href="/developer/"><strong>開発・変換</strong><small>3</small></a>
              <ul><li><a class:active={pathname === '/tools/json-formatter/'} href="/tools/json-formatter/">JSON整形・検証</a></li><li><a class:active={pathname === '/tools/url-encoder/'} href="/tools/url-encoder/">URLエンコード</a></li><li><a class:active={pathname === '/tools/base64-converter/'} href="/tools/base64-converter/">Base64変換</a></li></ul>
            </section>
            <section class="sidebar-section">
              <a class:list={['sidebar-category', {active: pathname === '/security/'}]} href="/security/"><strong>セキュリティ</strong><small>1</small></a>
              <ul><li><a class:active={pathname === '/tools/password-generator/'} href="/tools/password-generator/">パスワード生成</a></li></ul>
            </section>
            <section class="sidebar-section sidebar-guides">
              <p class="sidebar-label">読みもの</p>
              <a class:list={['sidebar-overview', {active: pathname === '/articles/'}]} href="/articles/"><span>記事一覧</span><small>2</small></a>
              <ul><li><a class:active={pathname === '/articles/sitemap-xml/'} href="/articles/sitemap-xml/">sitemap.xmlの作り方</a></li><li><a class:active={pathname === '/articles/robots-txt/'} href="/articles/robots-txt/">robots.txtの書き方</a></li></ul>
            </section>
            <section class="sidebar-section sidebar-support">
              <p class="sidebar-label">サイト情報</p>
              <ul><li><a class:active={pathname === '/about/'} href="/about/">このサイトについて</a></li><li><a class:active={pathname === '/updates/'} href="/updates/">更新履歴</a></li></ul>
            </section>
          </nav>
          <p class="sidebar-note">現在8種類のツールと2本の記事を公開中です。</p>
        </details>
      </aside>
      <main id="content"><slot /></main>
    </div>
    <footer>
      <div><a class="logo footer-logo" href="/"><span>WT</span> WebTools</a><p>Web制作の小さな手間を、ブラウザだけで。</p></div>
      <nav aria-label="フッターナビゲーション"><a href="/about/">運営方針</a><a href="/updates/">更新履歴</a><a href="/privacy/">プライバシー</a><a href="/terms/">利用規約</a></nav>
      <p class="site-disclaimer">各ツールの結果は必ず内容を確認し、利用者自身の判断と責任でご利用ください。詳しくは<a href="/terms/">免責事項</a>をご確認ください。</p>
      <p class="copyright">© {new Date().getFullYear()} WebTools</p>
    </footer>
  </body>
</html>
