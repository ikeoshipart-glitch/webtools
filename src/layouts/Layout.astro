---
import '../styles/global.css';
import '../styles/tools-extra.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'WebTools',
  url: Astro.site,
  description: 'Web制作で繰り返し使う小さな作業を、ブラウザ内で完結できる無料ツール集。',
  inLanguage: 'ja',
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="ChxBItZ8wJLGirYfTZekqkrSHAP_QJ440MrNzSMp6ow" />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="WebTools" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">本文へ移動</a>
    <header class="site-header">
      <a class="logo" href="/" aria-label="WebTools トップページ"><span>WT</span> WebTools</a>
      <nav aria-label="メインナビゲーション">
        <a href="/#tools">ツール一覧</a><a href="/articles/robots-txt/">読みもの</a><a href="/about/">このサイトについて</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer>
      <div><a class="logo footer-logo" href="/"><span>WT</span> WebTools</a><p>Web制作の小さな手間を、ブラウザだけで。</p></div>
      <nav aria-label="フッターナビゲーション"><a href="/about/">運営方針</a><a href="/updates/">更新履歴</a><a href="/privacy/">プライバシー</a><a href="/terms/">利用規約</a></nav>
      <p class="copyright">© {new Date().getFullYear()} WebTools</p>
    </footer>
  </body>
</html>
